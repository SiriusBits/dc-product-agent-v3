{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env"
    ],
    "tasks": {
        "generate": {
            "dependsOn": [
                "^generate"
            ],
            "inputs": [
                "scripts/**",
                "../../reference/schema/*.schema.json"
            ],
            "outputs": [
                "src/types/generated.ts",
                "src/**/generated/**"
            ]
        },
        "build": {
            "dependsOn": [
                "^build",
                "generate"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "lint": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "inputs": [
                "src/**/*.tsx",
                "src/**/*.ts",
                "test/**/*.ts",
                "test/**/*.tsx"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}
