{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs",
            "outDir": null
        },
        "include": ["scripts"]
    }
}
