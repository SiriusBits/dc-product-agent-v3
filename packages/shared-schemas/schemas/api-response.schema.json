{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/api-response.schema.json",
  "title": "API Response Schema",
  "type": "object",
  "properties": {
    "data": {
      "description": "The response data payload"
    },
    "success": {
      "type": "boolean",
      "description": "Indicates if the request was successful"
    },
    "message": {
      "type": "string",
      "description": "Optional message providing additional context"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the response"
    },
    "request_id": {
      "type": "string",
      "description": "Unique identifier for request tracing"
    }
  },
  "required": ["data", "success", "timestamp"],
  "additionalProperties": false
}
