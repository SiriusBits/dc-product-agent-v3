{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/chat-response.schema.json",
  "title": "Chat Response Schema",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "description": "The generated answer to the user's query"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retrieval_result"
      },
      "description": "Source documents and passages used to generate the answer"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Conversation identifier for context tracking"
    },
    "query_analysis": {
      "type": "object",
      "properties": {
        "query_type": {
          "type": "string",
          "enum": [
            "specification",
            "application",
            "comparison",
            "relationship",
            "general"
          ],
          "description": "Classified type of the user's query"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extracted entities from the query"
        },
        "intent_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the query classification"
        },
        "suggested_strategy": {
          "type": "object",
          "description": "Suggested retrieval strategy based on query analysis"
        }
      },
      "required": ["query_type", "entities", "intent_confidence"],
      "additionalProperties": false
    },
    "response_time_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Time taken to generate the response in milliseconds"
    },
    "kg_enhanced": {
      "type": "boolean",
      "description": "Whether knowledge graph data was used to enhance the response"
    }
  },
  "required": [
    "answer",
    "sources",
    "conversation_id",
    "query_analysis",
    "response_time_ms",
    "kg_enhanced"
  ],
  "additionalProperties": false,
  "$defs": {
    "retrieval_result": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "The retrieved content or passage"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Relevance score for this result"
        },
        "source": {
          "type": "string",
          "enum": ["vector", "kg", "hybrid"],
          "description": "Source system that provided this result"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata about the result"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "description": "Source document identifier"
            },
            "page": {
              "type": "integer",
              "description": "Page number in source document"
            },
            "section": {
              "type": "string",
              "description": "Section name in source document"
            }
          },
          "additionalProperties": true,
          "description": "Provenance information for the result"
        }
      },
      "required": ["content", "score", "source", "metadata", "provenance"],
      "additionalProperties": false
    }
  }
}
