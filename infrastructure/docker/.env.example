# DC Agent Infrastructure Environment Configuration

# Neo4j Configuration
NEO4J_AUTH=neo4j/password123
NEO4J_PLUGINS=["apoc", "graph-data-science"]
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Chroma Configuration
CHROMA_SERVER_HOST=0.0.0.0
CHROMA_SERVER_HTTP_PORT=8000
CHROMA_PERSIST_DIRECTORY=/chroma/chroma

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# PostgreSQL Configuration
POSTGRES_DB=dc_agent
POSTGRES_USER=dc_agent
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# n8n Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/New_York

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# External Services
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# Application Configuration
DC_AGENT_BACKEND_URL=http://host.docker.internal:8000
DC_AGENT_FRONTEND_URL=http://localhost:3000

# Development Settings
COMPOSE_PROJECT_NAME=dc-agent
COMPOSE_FILE=docker-compose.yml