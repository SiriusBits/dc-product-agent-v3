{
  "name": "DC Agent n8n Configuration",
  "description": "Configuration settings for n8n workflow automation",
  "version": "1.0.0",
  "settings": {
    "timezone": "America/New_York",
    "defaultLocale": "en",
    "userManagement": {
      "disabled": false,
      "emails": {
        "mode": "smtp",
        "smtp": {
          "host": "localhost",
          "port": 587,
          "secure": false,
          "auth": {
            "user": "",
            "pass": ""
          }
        }
      }
    },
    "endpoints": {
      "rest": "rest",
      "webhook": "webhook",
      "webhookWaiting": "webhook-waiting",
      "webhookTest": "webhook-test"
    },
    "security": {
      "basicAuth": {
        "active": true,
        "user": "admin",
        "password": "admin123"
      },
      "jwtAuth": {
        "active": false,
        "jwtHeader": "authorization",
        "jwtHeaderValuePrefix": "Bearer",
        "jwksUri": "",
        "jwtIssuer": "",
        "jwtNamespace": "",
        "jwtAllowedTenantKey": "",
        "jwtAllowedTenant": ""
      }
    },
    "nodes": {
      "exclude": [],
      "include": []
    },
    "workflows": {
      "defaultName": "My workflow",
      "onlySaveExecutionProgress": false,
      "callerPolicyDefaultOption": "workflowsFromSameOwner"
    },
    "executions": {
      "process": "main",
      "mode": "regular",
      "timeout": 3600,
      "maxTimeout": 3600,
      "saveDataOnError": "all",
      "saveDataOnSuccess": "all",
      "saveDataManualExecutions": true,
      "pruneData": true,
      "pruneDataMaxAge": 336,
      "pruneDataTimeout": 3600
    },
    "queue": {
      "health": {
        "active": false,
        "port": 5679
      }
    },
    "externalHooks": {},
    "logs": {
      "level": "info",
      "output": "console,file",
      "file": {
        "fileCountMax": 100,
        "fileSizeMax": 16,
        "location": "logs/n8n.log"
      }
    },
    "metrics": {
      "enable": false,
      "prefix": "n8n_",
      "includeDefaultMetrics": true,
      "includeWorkflowIdLabel": false,
      "includeNodeTypeLabel": false,
      "includeCredentialTypeLabel": false,
      "includeApiEndpoints": false,
      "includeApiPathLabel": false,
      "includeApiMethodLabel": false,
      "includeApiStatusCodeLabel": false
    }
  },
  "credentials": {
    "overwrite": {
      "data": {},
      "endpoint": ""
    }
  },
  "workflows": [
    {
      "name": "PDF Processing Workflow",
      "file": "pdf-processing-workflow.json",
      "description": "Processes PDF documents through extraction and ingestion pipeline",
      "active": true,
      "tags": ["pdf", "processing", "ingestion"]
    },
    {
      "name": "Data Quality Monitoring",
      "file": "data-quality-monitoring.json",
      "description": "Monitors system health and data quality metrics",
      "active": true,
      "tags": ["monitoring", "quality", "health"]
    },
    {
      "name": "Data Refresh and Reindexing",
      "file": "data-refresh-workflow.json",
      "description": "Refreshes and reindexes data across vector and knowledge graph databases",
      "active": true,
      "tags": ["refresh", "reindex", "maintenance"]
    }
  ],
  "webhooks": [
    {
      "name": "process-pdf",
      "description": "Webhook for triggering PDF processing workflow",
      "method": "POST",
      "path": "process-pdf",
      "workflow": "PDF Processing Workflow"
    },
    {
      "name": "refresh-data",
      "description": "Webhook for triggering data refresh workflow",
      "method": "POST",
      "path": "refresh-data",
      "workflow": "Data Refresh and Reindexing"
    },
    {
      "name": "quality-check",
      "description": "Webhook for triggering quality monitoring",
      "method": "POST",
      "path": "quality-check",
      "workflow": "Data Quality Monitoring"
    }
  ],
  "environment": {
    "development": {
      "N8N_BASIC_AUTH_ACTIVE": "true",
      "N8N_BASIC_AUTH_USER": "admin",
      "N8N_BASIC_AUTH_PASSWORD": "admin123",
      "N8N_HOST": "0.0.0.0",
      "N8N_PORT": "5678",
      "N8N_PROTOCOL": "http",
      "WEBHOOK_URL": "http://localhost:5678/",
      "GENERIC_TIMEZONE": "America/New_York",
      "N8N_LOG_LEVEL": "info",
      "N8N_LOG_OUTPUT": "console",
      "DB_TYPE": "postgresdb",
      "DB_POSTGRESDB_HOST": "postgres",
      "DB_POSTGRESDB_PORT": "5432",
      "DB_POSTGRESDB_DATABASE": "n8n",
      "DB_POSTGRESDB_USER": "n8n",
      "DB_POSTGRESDB_PASSWORD": "n8n123"
    },
    "production": {
      "N8N_BASIC_AUTH_ACTIVE": "true",
      "N8N_BASIC_AUTH_USER": "${N8N_BASIC_AUTH_USER}",
      "N8N_BASIC_AUTH_PASSWORD": "${N8N_BASIC_AUTH_PASSWORD}",
      "N8N_HOST": "0.0.0.0",
      "N8N_PORT": "5678",
      "N8N_PROTOCOL": "https",
      "WEBHOOK_URL": "${WEBHOOK_URL}",
      "GENERIC_TIMEZONE": "${TIMEZONE}",
      "N8N_LOG_LEVEL": "warn",
      "N8N_LOG_OUTPUT": "file",
      "DB_TYPE": "postgresdb",
      "DB_POSTGRESDB_HOST": "${DB_HOST}",
      "DB_POSTGRESDB_PORT": "${DB_PORT}",
      "DB_POSTGRESDB_DATABASE": "${DB_NAME}",
      "DB_POSTGRESDB_USER": "${DB_USER}",
      "DB_POSTGRESDB_PASSWORD": "${DB_PASSWORD}"
    }
  }
}
