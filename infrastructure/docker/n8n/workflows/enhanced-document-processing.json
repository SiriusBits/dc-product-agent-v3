{
  "name": "Enhanced Document Processing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-document",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Document Processing Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 400],
      "webhookId": "enhanced-document-processing"
    },
    {
      "parameters": {
        "functionCode": "// Validate and prepare document processing request\nconst items = $input.all();\nconst requestData = items[0].json;\n\n// Validate required fields\nif (!requestData.filename && !requestData.document_data) {\n  throw new Error('Missing required fields: filename or document_data');\n}\n\n// Prepare processing configuration\nconst config = {\n  filename: requestData.filename,\n  document_data: requestData.document_data,\n  file_path: requestData.file_path,\n  processing_id: `proc_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n  \n  // Processing options\n  chunking_strategy: requestData.chunking_strategy || 'semantic',\n  chunk_size: requestData.chunk_size || 1000,\n  chunk_overlap: requestData.chunk_overlap || 200,\n  generate_embeddings: requestData.generate_embeddings !== false,\n  ingest_to_vector: requestData.ingest_to_vector !== false,\n  ingest_to_kg: requestData.ingest_to_kg !== false,\n  \n  // Collection settings\n  collection_name: requestData.collection_name || 'technical_bulletins',\n  overwrite: requestData.overwrite || false,\n  \n  // Metadata\n  status: 'processing',\n  started_at: new Date().toISOString(),\n  source: 'n8n_workflow'\n};\n\nreturn { json: config };"
      },
      "id": "validate-and-prepare",
      "name": "Validate and Prepare",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-document-data",
              "leftValue": "={{$json.document_data}}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-document-type",
      "name": "Check Document Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/ingest/document",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
