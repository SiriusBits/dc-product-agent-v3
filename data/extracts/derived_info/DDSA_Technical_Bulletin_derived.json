  "derived_info": {
    "summary": "DDSA (Dodecenylsuccinic Anhydride) is a liquid anhydride epoxy curing agent manufactured by Dixie Chemical. It provides excellent electrical properties, flexibility, and long pot life at room temperature. The document contains comprehensive performance data including 11 graphs showing temperature-dependent properties, post-cure effects, and mechanical testing results across multiple formulations. Key applications include electrical potting compounds, coatings, conductive adhesives, and syntactic foams.",
    "personas": {
      "sales_summary": "DDSA offers exceptional value for electrical and high-performance applications with its unique combination of long pot life, excellent electrical properties, and flexibility. The extensive performance data demonstrates consistent quality across multiple formulations and cure conditions, making it ideal for demanding applications requiring chemical resistance and thermal stability.",
      "technical_summary": "DDSA is a 266 molecular weight liquid anhydride with 97% minimum purity and specific gravity of 1.002 g/cc at 25°C. Performance data shows optimal usage at 80-150 phr with BPA epoxy resins, with 140 phr recommended for high-performance applications. Post-cure studies demonstrate improved HDT (60-75°C), reduced water absorption (1.0-0.35%), and enhanced mechanical properties with extended cure times."
    },
    "key_applications": [
      "Electrical potting compounds",
      "Coatings for chemical resistance",
      "Conductive adhesives",
