# Frontend Environment Configuration
# Copy this file to .env and update the values

# API Configuration
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_API_TIMEOUT=30000

# Application Settings
PUBLIC_APP_NAME="Dixie Chemical Product Agent"
PUBLIC_APP_VERSION="3.0.0"

# Development Settings
NODE_ENV=development
PUBLIC_DEBUG=true

# Analytics (if needed)
PUBLIC_ANALYTICS_ID=""

# Feature Flags
PUBLIC_ENABLE_CHAT=true
PUBLIC_ENABLE_PRODUCT_BROWSER=true
PUBLIC_ENABLE_KNOWLEDGE_GRAPH=true