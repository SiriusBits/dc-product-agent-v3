---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // In a real app, you'd fetch product IDs from your API
  // For now, return empty array to enable dynamic routing
  return [];
}

const { id } = Astro.params;
const title = `Product Details - Dixie Chemical Product Agent`;
---

<Layout title={title} currentPage="browse">
  <div class="container mx-auto px-4 py-8">
    <div id="product-detail-container" data-product-id={id}>
      <!-- Product detail will be rendered by React component -->
    </div>
  </div>

  <script>
    import { createRoot } from 'react-dom/client';
    import { createElement } from 'react';
    import ProductDetailPage from '../../components/products/ProductDetailPage.tsx';

    const container = document.getElementById('product-detail-container');
    const productId = container?.getAttribute('data-product-id');
    
    if (container && productId) {
      const root = createRoot(container);
      root.render(createElement(ProductDetailPage, { productId }));
    }
  </script>
</Layout>