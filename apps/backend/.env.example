# Backend Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME="Dixie Chemical Product Agent Backend"
APP_VERSION="3.0.0"
DEBUG=true
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_PREFIX=/api/v1

# Database Connections
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SETTINGS={"anonymized_telemetry": false}

REDIS_URL=redis://:redis123@localhost:6379/0

POSTGRES_URL=postgresql://dc_agent:postgres123@localhost:5432/dc_agent

# Ollama Configuration (External on macOS)
# When running in Docker, use host.docker.internal
# When running locally, use localhost
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EMBEDDING=nomic-embed-text
OLLAMA_MODEL_CHAT=llama2:7b-chat

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=50MB

# Logging
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Development Settings
RELOAD=true
WORKERS=1